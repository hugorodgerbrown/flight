#!/usr/bin/env python3
"""Draw the app icons in static/icons/ from Flight's logo SVGs in docs/brand/.

The SVGs are the source (docs/brand/README.md); this rasterises them with
the Playwright browser the e2e tests already use, and writes the favicon.
Needs Pillow for the .ico:

    uv run --group e2e --with pillow python bin/make-icons
"""

import io
import logging
import shutil
from pathlib import Path

from PIL import Image
from playwright.sync_api import sync_playwright

logger = logging.getLogger(__name__)

ROOT = Path(__file__).resolve().parent.parent
BRAND = ROOT / "docs" / "brand"
OUT = ROOT / "static" / "icons"

# (source SVG, output PNG, size in px). iOS ignores transparency, so its
# icon is the full-bleed (maskable) tile, which it rounds itself.
ICONS = [
    ("flight-icon.svg", "icon-192.png", 192),
    ("flight-icon.svg", "icon-512.png", 512),
    ("flight-icon-maskable.svg", "icon-maskable-512.png", 512),
    ("flight-icon-maskable.svg", "apple-touch-icon.png", 180),
]


def rasterise(page: object, svg: str, size: int) -> Image.Image:
    """Return ``svg`` drawn at ``size`` px square, with a transparent background."""
    sized = svg.replace('width="100" height="100"', f'width="{size}" height="{size}"', 1)
    page.set_viewport_size({"width": size, "height": size})  # type: ignore[attr-defined]
    page.set_content(f'<body style="margin:0">{sized}</body>')  # type: ignore[attr-defined]
    png = page.screenshot(omit_background=True, clip={"x": 0, "y": 0, "width": size, "height": size})  # type: ignore[attr-defined]
    return Image.open(io.BytesIO(png))


def main() -> None:
    """Write every icon the manifest and _head.html reference."""
    logging.basicConfig(level=logging.INFO, format="%(message)s")
    with sync_playwright() as p:
        browser = p.chromium.launch()
        page = browser.new_page()
        for source, name, size in ICONS:
            image = rasterise(page, (BRAND / source).read_text(), size)
            if name == "apple-touch-icon.png":
                image = image.convert("RGB")
            image.save(OUT / name, optimize=True)
            logger.info("Wrote %s", name)
        favicon = rasterise(page, (BRAND / "favicon.svg").read_text(), 48)
        favicon.save(OUT / "favicon.ico", sizes=[(16, 16), (32, 32), (48, 48)])
        logger.info("Wrote favicon.ico")
        browser.close()
    shutil.copy(BRAND / "favicon.svg", OUT / "favicon.svg")
    logger.info("Wrote favicon.svg")


if __name__ == "__main__":
    main()
