#!/usr/bin/env python3
"""Write static/js/flight_land.js: the world's land as one SVG path.

The flight map view (an MCP App) loads nothing over the network, so it
carries its own base map. This turns a Natural Earth land TopoJSON (public
domain, from the world-atlas npm package) into a single path in Web
Mercator, x and y in degrees: x = longitude + 180 (0 to 360), y = 0 at
85 degrees north. Run it only when the base map should change:

    npm pack world-atlas@2.0.2 && tar xzf world-atlas-2.0.2.tgz
    bin/make-land-map package/land-50m.json

Points are rounded to PRECISION degrees, points closer than MIN_STEP are
dropped and so are islands smaller than MIN_SIZE, which keeps the file
small at the zoom a flight's route needs.
"""

import json
import logging
import math
import sys
from pathlib import Path
from typing import Any

logger = logging.getLogger(__name__)

OUT = Path(__file__).resolve().parent.parent / "static" / "js" / "flight_land.js"
PRECISION = 1  # decimal places of a degree
MIN_STEP = 0.35  # degrees between kept points
MIN_SIZE = 1.0  # degrees across: smaller islands are dropped
MAX_LAT = 85.0
TOP = math.degrees(math.log(math.tan(math.pi / 4 + math.radians(MAX_LAT) / 2)))


def project(lon: float, lat: float) -> tuple[float, float]:
    """Return Web Mercator (x, y) in degrees, y growing southwards from 85N."""
    lat = max(-MAX_LAT, min(MAX_LAT, lat))
    y = math.degrees(math.log(math.tan(math.pi / 4 + math.radians(lat) / 2)))
    return lon + 180, TOP - y


def decode_arcs(topology: dict[str, Any]) -> list[list[tuple[float, float]]]:
    """Return every arc as absolute (lon, lat) points."""
    (sx, sy), (tx, ty) = topology["transform"]["scale"], topology["transform"]["translate"]
    arcs = []
    for arc in topology["arcs"]:
        x = y = 0
        points = []
        for dx, dy in arc:
            x, y = x + dx, y + dy
            points.append((x * sx + tx, y * sy + ty))
        arcs.append(points)
    return arcs


def ring(indices: list[int], arcs: list[list[tuple[float, float]]]) -> list[tuple[float, float]]:
    """Join a ring's arcs; ~i means arc i reversed."""
    points: list[tuple[float, float]] = []
    for i in indices:
        arc = arcs[i] if i >= 0 else arcs[~i][::-1]
        points.extend(arc if not points else arc[1:])
    return points


def polygons(geometry: dict[str, Any]) -> list[list[list[int]]]:
    """Return a geometry's polygons as lists of rings of arc indices."""
    kind = geometry["type"]
    if kind == "GeometryCollection":
        return [p for g in geometry["geometries"] for p in polygons(g)]
    if kind == "Polygon":
        return [geometry["arcs"]]
    if kind == "MultiPolygon":
        return list(geometry["arcs"])
    return []


def path(topology: dict[str, Any]) -> str:
    """Return the land as SVG path data."""
    arcs = decode_arcs(topology)
    parts = []
    for polygon in polygons(topology["objects"]["land"]):
        for indices in polygon:
            points = []
            for lon, lat in ring(indices, arcs):
                x, y = project(lon, lat)
                point = (round(x, PRECISION), round(y, PRECISION))
                if not points or max(abs(point[0] - points[-1][0]), abs(point[1] - points[-1][1])) >= MIN_STEP:
                    points.append(point)
            xs, ys = [x for x, _ in points], [y for _, y in points]
            if len(points) < 4 or max(max(xs) - min(xs), max(ys) - min(ys)) < MIN_SIZE:
                continue
            first, *rest = (f"{x:g} {y:g}" for x, y in points)
            parts.append(f"M{first}L{'L'.join(rest)}Z")
    return "".join(parts)


def main(argv: list[str]) -> int:
    """Read the TopoJSON named in argv and write OUT."""
    logging.basicConfig(level=logging.INFO, format="%(message)s")
    if len(argv) != 2:
        logger.error("usage: bin/make-land-map <land-topojson>")
        return 1
    data = path(json.loads(Path(argv[1]).read_text()))
    OUT.write_text(
        "/*\n"
        " * static/js/flight_land.js - the world's land for the flight map view.\n"
        " *\n"
        " * Generated by bin/make-land-map from Natural Earth (public domain); do\n"
        " * not edit by hand. Web Mercator in degrees: x = longitude + 180,\n"
        " * y = 0 at 85 degrees north.\n"
        " */\n"
        f"self.FlightLand = '{data}';\n"
    )
    logger.info("wrote %s (%d bytes)", OUT, OUT.stat().st_size)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
